# PesaGuard Staging Environment Configuration (.env.staging)
# Current Date Anchor: July 2026

# Database & Redis (Staging Isolated Instances)
DATABASE_URL=postgresql://pesaguard:pesaguard@localhost:5433/pesaguard_staging
REDIS_URL=redis://localhost:6380/0

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=mpesa.transactions.raw.staging
KAFKA_TOPIC_MATCHED=mpesa.transactions.matched.staging
KAFKA_TOPIC_DISCREPANCIES=mpesa.discrepancies.staging

# Tenant & Connector Settings
TENANT_ID=staging-tenant
CONNECTOR_TYPE=postgres
INTERNAL_RECORDS_TABLE=orders_staging
CONNECTOR_MAPPING_FILE=
CONNECTOR_REST_ENDPOINT=
CONNECTOR_AUTH_TYPE=api_key
CONNECTOR_AUTH_VALUE=

# Notification Channels (Staging Alert Webhook)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/StagingAlertsWebhook

# Reconciliation Parameters
RECONCILIATION_WINDOW_MINUTES=15
RQ_QUEUE_NAME=transaction_events_staging

# Safaricom Daraja API Credentials
# Canonical spelling is DARAJA_*. DarajaConfig also accepts legacy DARJA_* aliases for
# backward compatibility, but it reads the canonical name first — set the canonical
# variables below and leave the legacy aliases unset in new deployments.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=replace-me
DARAJA_CONSUMER_SECRET=replace-me

# Airtel Money Credentials (Sandbox)
AIRTEL_BASE_URL=https://sandbox.example.com
AIRTEL_API_KEY=replace-me
AIRTEL_API_SECRET=replace-me

# Authentication & Admin
JWT_SECRET_KEY=replace-me
PESAGUARD_ADMIN_API_TOKEN=replace-me

# Observability (optional in staging)
SENTRY_DSN=
LOG_LEVEL=INFO

# Backup & Deployment Readiness Controls
# Backups must exist and be fresher than PESAGUARD_BACKUP_MAX_AGE_HOURS for the
# readiness control to report "ready"; otherwise it reports "configured".
PESAGUARD_BACKUP_DIR=/var/backups/pesaguard
PESAGUARD_BACKUP_RETENTION_DAYS=30
PESAGUARD_BACKUP_MAX_AGE_HOURS=26
