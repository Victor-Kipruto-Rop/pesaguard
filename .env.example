# PesaGuard Production Environment Configuration (.env)
# Current Date Anchor: July 2026

# Database & Storage
DATABASE_URL=postgresql://pesaguard:pesaguard@localhost:5432/pesaguard
REDIS_URL=redis://localhost:6379/0

# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=mpesa.transactions.raw
KAFKA_TOPIC_MATCHED=mpesa.transactions.matched
KAFKA_TOPIC_DISCREPANCIES=mpesa.discrepancies

# Tenant & Connector Settings
TENANT_ID=default
CONNECTOR_TYPE=postgres
INTERNAL_RECORDS_TABLE=orders
CONNECTOR_MAPPING_FILE=
CONNECTOR_REST_ENDPOINT=
CONNECTOR_AUTH_TYPE=api_key
CONNECTOR_AUTH_VALUE=

# Notification Channels
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/X00

# Reconciliation Parameters
RECONCILIATION_WINDOW_MINUTES=15
RQ_QUEUE_NAME=transaction_events

# Safaricom Daraja API Credentials (Sandbox / Production)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_daraja_consumer_key_here
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Airtel Money Credentials (Sandbox / Production)
AIRTEL_BASE_URL=https://sandbox.example.com
AIRTEL_API_KEY=your_airtel_api_key_here
AIRTEL_API_SECRET=your_airtel_api_secret_here

# Tenant-scoped overrides (recommended)
# Example: ACME_AIRTEL_API_KEY, ACME_AIRTEL_API_SECRET, ACME_AIRTEL_BASE_URL

# Health Check Toggles (all enabled by default; disable only in constrained environments)
PESAGUARD_HEALTH_CHECK_KAFKA=1
PESAGUARD_HEALTH_CHECK_REDIS=1
PESAGUARD_HEALTH_CHECK_DARAJA=1

# Deployment Readiness Controls (reported by /status and the deploy gate)
# Backup artifacts are discovered in PESAGUARD_BACKUP_DIR (default /var/backups/pesaguard).
PESAGUARD_BACKUP_DIR=/var/backups/pesaguard
PESAGUARD_BACKUP_RETENTION_DAYS=30
# A newest backup older than this window downgrades the backup control from
# "ready" to "configured" (tooling present, but not producing fresh artifacts).
PESAGUARD_BACKUP_MAX_AGE_HOURS=26

# Incident Response Paging Channels
# Any one channel configured keeps the incident_response control usable.
# Slack uses SLACK_WEBHOOK_URL (see Notification Channels above).
SMS_ALERT_RECIPIENT=
ALERT_EMAIL_RECIPIENTS=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
